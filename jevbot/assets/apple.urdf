<?xml version="1.0"?>
<!-- A small apple: red sphere body with a short brown stem. -->
<robot name="apple">
  <link name="body">
    <inertial>
      <mass value="0.05"/>
      <!-- solid sphere, r=0.026: I = 2/5 m r^2 -->
      <inertia ixx="1.35e-5" ixy="0" ixz="0" iyy="1.35e-5" iyz="0" izz="1.35e-5"/>
    </inertial>
    <visual>
      <geometry><sphere radius="0.026"/></geometry>
      <material name="apple_red"><color rgba="0.85 0.08 0.08 1"/></material>
    </visual>
    <collision>
      <geometry><sphere radius="0.026"/></geometry>
    </collision>
  </link>
  <link name="stem">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
    <visual>
      <geometry><cylinder radius="0.004" length="0.03"/></geometry>
      <material name="stem_brown"><color rgba="0.35 0.22 0.08 1"/></material>
    </visual>
  </link>
  <joint name="stem_joint" type="fixed">
    <parent link="body"/>
    <child link="stem"/>
    <origin xyz="0 0 0.034"/>
  </joint>
</robot>
